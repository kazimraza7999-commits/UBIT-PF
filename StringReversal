package Ubit;

import java.util.Scanner;

public class stringReversal {
    static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        String x=input.nextLine();

        String rev = "";
        for (int i=x.length()-1 ; i>=0 ; i--){
            rev+=x.charAt(i);
        }
        System.out.print(rev);
    }
}
