package Practice;

import java.util.ArrayList;

public class GeometricSequence {
    public static ArrayList<Integer> generateGP(int a,int r,int n){
        ArrayList<Integer> sequence = new ArrayList<>();
        int term = a;
        for ( int i=0 ; i<n ; i++){
            sequence.add(term);
            term = term * r;
        }
        return sequence;
    }

    static void main(String[] args) {
        int a=2;
        int r=3;
        int n=4;
        ArrayList<Integer> answer = generateGP(a,r,n);
        System.out.println(answer);
    }
}
