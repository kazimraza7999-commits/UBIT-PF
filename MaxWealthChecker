package Practice;
public class WealthChecker {
    static void main(String[] args) {
        int[][] customer={
        {1,2},
        {2,4},
        {4,6}
        };
        int result = maxwealth(customer);
        System.out.println(result);
    }

    private static int maxwealth(int[][] customer) {
        int maxwealth=0;
        for(int i=0 ; i< customer.length;i++){
            int currentwealth=0;
            for(int j=0; j< customer[i].length;j++){
                currentwealth=currentwealth+customer[i][j];
            }
            if(currentwealth>maxwealth){
                maxwealth=currentwealth;
            }
        }
        return maxwealth;
    }
}
