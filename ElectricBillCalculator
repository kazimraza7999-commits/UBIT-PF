package Practice;

import java.util.Scanner;

public class ElectricBill {
    static void main(String[] args) {
        System.out.println("Enter Units to calculate bill : ");
        Scanner sc = new Scanner(System.in);
        int units = sc.nextInt();
        double TotalBill = calculateBill(units);
        System.out.println(TotalBill+" PKR");
    }

    private static double calculateBill(int units) {
        double bill=0;
        if (units <= 100) {
            bill = units * 15;
        } else if (units <= 300) {
            bill = (100 * 15) + ((units - 100) * 25);
        } else if (units <= 500) {
            bill = (100 * 15) + (200 * 25) + ((units - 300) * 35);
        } else {
            bill = (100 * 15) + (200 * 25) + (200 * 35) + ((units - 500) * 50);
        }
        return bill;
    }
    }
